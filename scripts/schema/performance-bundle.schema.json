{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ten-bagger.local/schemas/performance-bundle.schema.json",
  "title": "PerformanceBundle",
  "$comment": "Enforced by validate:content / gen:types (#63). ADR-0002/0003 field semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "market", "asOfDate", "runMeta", "measurements"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "market": {
      "type": "string",
      "enum": ["KR", "US"]
    },
    "asOfDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "runMeta": { "$ref": "#/$defs/runMeta" },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/performanceMeasurement" }
    }
  },
  "$defs": {
    "horizonId": {
      "type": "string",
      "enum": ["H20", "H60", "1M", "3M", "6M", "1Y", "3Y", "5Y"]
    },
    "completionStatus": {
      "type": "string",
      "enum": ["complete", "incomplete"]
    },
    "incompleteReason": {
      "type": "string",
      "enum": [
        "missing_entry",
        "invalid_entry",
        "missing_exit",
        "horizon_beyond_asof",
        "insufficient_history",
        "series_break"
      ]
    },
    "benchmarkIncompleteReason": {
      "type": "string",
      "enum": [
        "missing_benchmark_series",
        "missing_benchmark_exit",
        "horizon_beyond_asof"
      ]
    },
    "survivorshipFlag": {
      "type": "string",
      "enum": ["listed", "delisted", "unknown"]
    },
    "runMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "priceAdjustment", "generatedAt", "asOfDate"],
      "properties": {
        "provider": { "type": "string" },
        "priceAdjustment": { "type": "string" },
        "generatedAt": { "type": "string" },
        "asOfDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "performanceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "pickDate",
        "symbol",
        "horizonId",
        "benchmarkId",
        "completionStatus",
        "benchmarkCompletionStatus",
        "survivorshipFlag",
        "asOfDate"
      ],
      "properties": {
        "market": { "type": "string", "enum": ["KR", "US"] },
        "pickDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "symbol": { "type": "string", "minLength": 1 },
        "horizonId": { "$ref": "#/$defs/horizonId" },
        "horizonDays": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "benchmarkId": { "type": "string" },
        "completionStatus": { "$ref": "#/$defs/completionStatus" },
        "incompleteReason": { "$ref": "#/$defs/incompleteReason" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "forwardReturn": { "type": "number" },
        "benchmarkReturn": { "type": "number" },
        "benchmarkCompletionStatus": { "$ref": "#/$defs/completionStatus" },
        "benchmarkIncompleteReason": {
          "$ref": "#/$defs/benchmarkIncompleteReason"
        },
        "survivorshipFlag": { "$ref": "#/$defs/survivorshipFlag" },
        "asOfDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "completionStatus": { "const": "incomplete" } },
            "required": ["completionStatus"]
          },
          "then": { "required": ["incompleteReason"] }
        },
        {
          "if": {
            "properties": {
              "benchmarkCompletionStatus": { "const": "incomplete" }
            },
            "required": ["benchmarkCompletionStatus"]
          },
          "then": { "required": ["benchmarkIncompleteReason"] }
        }
      ]
    }
  }
}
