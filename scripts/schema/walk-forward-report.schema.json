{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ten-bagger.local/schemas/walk-forward-report.schema.json",
  "title": "WalkForwardReport",
  "$comment": "OOS walk-forward report (#66). Enforced by validate:content when present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "runIntent",
    "measurementSource",
    "configHash",
    "generatedAt",
    "candidateId",
    "foldSpec",
    "folds",
    "aggregate",
    "coverage"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "runIntent": { "type": "string", "enum": ["exploratory", "go_evidence"] },
    "measurementSource": {
      "type": "string",
      "enum": ["ledger", "fixture-recompute"]
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of canonical run config JSON; no secrets"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidateId": { "type": "string", "minLength": 1 },
    "foldSpec": { "$ref": "#/$defs/foldSpec" },
    "folds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fold" }
    },
    "aggregate": { "$ref": "#/$defs/aggregateMetrics" },
    "coverage": { "$ref": "#/$defs/coverageBlock" }
  },
  "allOf": [
    {
      "if": { "properties": { "runIntent": { "const": "go_evidence" } } },
      "then": {
        "properties": { "measurementSource": { "const": "ledger" } }
      }
    }
  ],
  "$defs": {
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "foldSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "trainSessions",
        "oosSessions",
        "stepSessions",
        "startDate",
        "endDate"
      ],
      "properties": {
        "mode": { "type": "string", "const": "rolling" },
        "trainSessions": { "type": "integer", "minimum": 1 },
        "oosSessions": { "type": "integer", "minimum": 1 },
        "stepSessions": { "type": "integer", "minimum": 1 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "foldStatus": {
      "type": "string",
      "enum": ["complete", "incomplete_horizon", "skipped_empty_train"]
    },
    "walkForwardHorizonId": { "type": "string", "enum": ["H20", "H60"] },
    "walkForwardBenchmarkId": { "type": "string", "enum": ["KR-KOSPI", "US-SPX"] },
    "horizonMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizonId", "benchmarkId", "status"],
      "properties": {
        "horizonId": { "$ref": "#/$defs/walkForwardHorizonId" },
        "benchmarkId": { "$ref": "#/$defs/walkForwardBenchmarkId" },
        "market": { "type": "string", "enum": ["KR", "US"] },
        "pickReturnMean": { "type": ["number", "null"] },
        "hitRate": { "type": ["number", "null"] },
        "excessReturnMean": { "type": ["number", "null"] },
        "status": { "type": "string", "enum": ["complete", "incomplete"] },
        "sampleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "fold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foldIndex",
        "trainRange",
        "oosRange",
        "status",
        "pickDays",
        "noPickDays",
        "horizons"
      ],
      "properties": {
        "foldIndex": { "type": "integer", "minimum": 0 },
        "trainRange": { "$ref": "#/$defs/dateRange" },
        "oosRange": { "$ref": "#/$defs/dateRange" },
        "status": { "$ref": "#/$defs/foldStatus" },
        "pickDays": { "type": "integer", "minimum": 0 },
        "noPickDays": { "type": "integer", "minimum": 0 },
        "horizons": {
          "type": "array",
          "items": { "$ref": "#/$defs/horizonMetrics" }
        }
      }
    },
    "aggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizons"],
      "properties": {
        "horizons": {
          "type": "array",
          "items": { "$ref": "#/$defs/horizonMetrics" }
        }
      }
    },
    "coverageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oosPickDays", "noPickDays", "noPickRatio", "insufficientCoverage"],
      "properties": {
        "oosPickDays": { "type": "integer", "minimum": 0 },
        "noPickDays": { "type": "integer", "minimum": 0 },
        "noPickRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "insufficientCoverage": { "type": "boolean" }
      }
    }
  }
}
