---
import { label, shortText, t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { localeHref } from '../lib/staticNav';
import type { DailyEntry, TopNCandidate } from '../lib/types';
import DualText from './DualText.astro';

interface Props {
  entry: DailyEntry;
  lang: Lang;
  detail?: boolean;
}

const { entry, lang, detail = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const profile = entry.stock?.profile;
const topCandidates = entry.topCandidates;
const scores = entry.scores;

/** Score colour scale: same hue as --accent, chroma drops with the score. */
function tone(value: number): string {
  if (value >= 80) return 'var(--s-high)';
  if (value >= 60) return 'var(--s-mid)';
  return 'var(--s-low)';
}

type AxisKey = 'size' | 'growth' | 'valuation' | 'entry' | 'momentum' | 'quality';

const AXIS_ORDER: AxisKey[] = ['size', 'growth', 'valuation', 'entry', 'momentum', 'quality'];

function axes(s: { [K in AxisKey]?: number }): { key: AxisKey; value: number }[] {
  return AXIS_ORDER.flatMap((key) => {
    const value = s[key];
    return value == null ? [] : [{ key, value }];
  });
}

function sparkBars(c: TopNCandidate) {
  return axes(c.scores);
}

function overview(langSel: Lang): string {
  if (!profile) return '';
  const full = t(profile.overview, langSel);
  return detail ? full : shortText(full);
}

const composite = scores?.composite ?? 0;
const threshold = scores?.threshold ?? 0;
const delta = composite - threshold;
---

<article class="card daily-card">
  <div class="daily-meta">
    <span class="num muted" style="font-size: 0.8rem;">{entry.date}</span>
    <span class="sep">·</span>
    <span class={`badge ${entry.market === 'KR' ? 'kr' : 'us'}`}>
      <span class="dot" style={`background: var(--${entry.market === 'KR' ? 'kr' : 'us'});`}></span>
      {entry.market === 'KR' ? (
        <span data-i18n="marketKR">{label('marketKR', lang)}</span>
      ) : (
        <span data-i18n="marketUS">{label('marketUS', lang)}</span>
      )}
    </span>
    <span class={`badge ${entry.status === 'pick' ? 'pick' : 'none'}`}>
      {entry.status === 'pick' ? (
        <span data-i18n="pick">{label('pick', lang)}</span>
      ) : (
        <span data-i18n="none">{label('none', lang)}</span>
      )}
    </span>
  </div>

  <div class="daily-body">
    {entry.status === 'no_pick' ? (
      <>
        <h1 data-i18n="noPickTitle">{label('noPickTitle', lang)}</h1>
        <p class="muted" data-i18n="noPickBody">{label('noPickBody', lang)}</p>
        {scores && (
          <p class="num muted" style="font-size: 0.82rem;">
            <span data-i18n="threshold">{label('threshold', lang)}</span>: {scores.threshold}
            {entry.meta && (
              <>
                {' · '}
                <span data-i18n="screened">{label('screened', lang)}</span>:{' '}
                {entry.meta.candidatesScreened}
              </>
            )}
          </p>
        )}
      </>
    ) : entry.stock && entry.reasoning && scores ? (
      <>
        <div class="daily-head">
          <div>
            <h1>{entry.stock.symbol}</h1>
            <p class="daily-name">
              <DualText text={entry.stock.name} lang={lang} />
            </p>
            <p class="daily-sub muted">
              {entry.stock.exchange}
              {profile?.sector && (
                <>
                  {' · '}
                  <DualText text={profile.sector} lang={lang} />
                </>
              )}
              {profile?.industry && (
                <>
                  {' / '}
                  <DualText text={profile.industry} lang={lang} />
                </>
              )}
            </p>
          </div>
          <div class="composite">
            <p class="eyebrow">
              <span data-i18n="composite">{label('composite', lang)}</span>
              {scores.version ? ` · Score v${scores.version}` : ''}
            </p>
            <p class="composite-value">
              <strong style={`color: ${tone(composite)};`}>{composite.toFixed(1)}</strong>
              <span class="num muted composite-max">/ 100</span>
            </p>
            <p class="num composite-delta">
              <span data-i18n="threshold">{label('threshold', lang)}</span>{' '}
              {threshold.toFixed(1)}
              {' · '}
              <span style={`color: ${tone(composite)}; font-weight: 600;`}>
                {delta >= 0 ? '+' : ''}{delta.toFixed(1)}
              </span>
            </p>
          </div>
        </div>

        <div class="threshold-meter">
          <div class="track">
            <span class="fill" style={`width: ${Math.min(Math.max(composite, 0), 100)}%;`}></span>
            <span class="marker" style={`left: ${Math.min(Math.max(threshold, 0), 100)}%;`}></span>
          </div>
          <div class="num threshold-scale">
            <span>0</span>
            <span class="at">
              <span data-i18n="threshold">{label('threshold', lang)}</span> {threshold.toFixed(1)}
            </span>
            <span>100</span>
          </div>
        </div>

        <div class="daily-summary">
          <DualText text={entry.reasoning.summary} lang={lang} as="p" />
        </div>

        <div class="axis-grid">
          {axes(scores).map((axis) => (
            <div class="axis-row">
              <span class="label" data-i18n={axis.key}>{label(axis.key, lang)}</span>
              <span class="track">
                <span
                  style={`width: ${Math.min(Math.max(axis.value, 0), 100)}%; background: ${tone(axis.value)};`}
                ></span>
              </span>
              <span class="num value" style={`color: ${tone(axis.value)};`}>
                {axis.value.toFixed(1)}
              </span>
            </div>
          ))}
        </div>

        {profile && (overview('ko') || overview('en')) && (
          <section class="profile-section">
            <p class="eyebrow" data-i18n="companyProfile">{label('companyProfile', lang)}</p>
            <p class="muted" data-i18n-show="ko" hidden={lang !== 'ko'}>{overview('ko')}</p>
            <p class="muted" data-i18n-show="en" hidden={lang !== 'en'}>{overview('en')}</p>
          </section>
        )}

        {detail ? (
          <div class="reasoning-section">
            {entry.reasoning.size && (
              <>
                <h2 class="section-title" data-i18n="size">{label('size', lang)}</h2>
                <DualText text={entry.reasoning.size} lang={lang} as="p" />
              </>
            )}
            <h2 class="section-title" data-i18n="growth">{label('growth', lang)}</h2>
            <DualText text={entry.reasoning.growth} lang={lang} as="p" />
            <h2 class="section-title" data-i18n="valuation">{label('valuation', lang)}</h2>
            <DualText text={entry.reasoning.valuation} lang={lang} as="p" />
            {entry.reasoning.entry && (
              <>
                <h2 class="section-title" data-i18n="entry">{label('entry', lang)}</h2>
                <DualText text={entry.reasoning.entry} lang={lang} as="p" />
              </>
            )}
            <h2 class="section-title" data-i18n="momentum">{label('momentum', lang)}</h2>
            <DualText text={entry.reasoning.momentum} lang={lang} as="p" />
            {entry.reasoning.quality && (
              <>
                <h2 class="section-title" data-i18n="quality">{label('quality', lang)}</h2>
                <DualText text={entry.reasoning.quality} lang={lang} as="p" />
              </>
            )}
            <h2 class="section-title" data-i18n="risks">{label('risks', lang)}</h2>
            <ul class="risk-list">
              {entry.reasoning.risks.map((risk) => (
                <DualText text={risk} lang={lang} as="li" />
              ))}
            </ul>
          </div>
        ) : (
          <p class="detail-link">
            <a class="btn" href={localeHref(base, lang, `daily/${entry.date}`)}>
              <span data-i18n="viewDetail">{label('viewDetail', lang)}</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </p>
        )}
      </>
    ) : null}
  </div>
</article>

{topCandidates && topCandidates.length > 0 && (
  <section class="top-n">
    <div class="top-n-head-row">
      <h2 class="section-title" style="margin: 0;" data-i18n="topCandidates">
        {label('topCandidates', lang)}
      </h2>
      <p class="muted top-n-help" data-i18n="topCandidatesHelp">
        {label('topCandidatesHelp', lang)}
      </p>
    </div>
    <ol class="top-n-list">
      {topCandidates.map((c) => (
        <li class="top-n-row">
          <span class="num top-n-rank">{c.rank}</span>
          <span class="top-n-id">
            <span class="num top-n-symbol">{c.symbol}</span>
            <span class="top-n-name">
              <DualText text={c.name} lang={lang} />
              <span class="exchange"> {c.exchange}</span>
            </span>
          </span>
          <span class="spark" aria-hidden="true">
            {sparkBars(c).map((axis) => (
              <span
                style={`height: ${Math.min(Math.max(axis.value, 0), 100)}%; background: ${tone(axis.value)};`}
              ></span>
            ))}
          </span>
          <span class="num top-n-score" style={`color: ${tone(c.scores.composite)};`}>
            {c.scores.composite.toFixed(1)}
          </span>
        </li>
      ))}
    </ol>
    <p class="num top-n-legend" data-i18n="scoreAxesLegend">{label('scoreAxesLegend', lang)}</p>
  </section>
)}
