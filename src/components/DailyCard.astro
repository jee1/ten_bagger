---
import { label, shortText, t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { DailyEntry, TopNCandidate } from '../lib/types';
import DualText from './DualText.astro';

interface Props {
  entry: DailyEntry;
  lang: Lang;
  detail?: boolean;
}

const { entry, lang, detail = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const profile = entry.stock?.profile;
const topCandidates = entry.topCandidates;

function axisRows(c: TopNCandidate) {
  const s = c.scores;
  return [
    { key: 'composite' as const, value: s.composite },
    { key: 'size' as const, value: s.size },
    { key: 'growth' as const, value: s.growth },
    { key: 'valuation' as const, value: s.valuation },
    { key: 'entry' as const, value: s.entry },
    { key: 'momentum' as const, value: s.momentum },
    { key: 'quality' as const, value: s.quality },
  ];
}

function overview(langSel: Lang): string {
  if (!profile) return '';
  const full = t(profile.overview, langSel);
  return detail ? full : shortText(full);
}
---

<article class="card">
  <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.75rem;">
    <span class="badge">{entry.date}</span>
    <span class={`badge ${entry.market === 'KR' ? 'kr' : 'us'}`}>
      {entry.market === 'KR' ? (
        <span data-i18n="marketKR">{label('marketKR', lang)}</span>
      ) : (
        <span data-i18n="marketUS">{label('marketUS', lang)}</span>
      )}
    </span>
    <span class={`badge ${entry.status === 'pick' ? 'pick' : 'none'}`}>
      {entry.status === 'pick' ? (
        <span data-i18n="pick">{label('pick', lang)}</span>
      ) : (
        <span data-i18n="none">{label('none', lang)}</span>
      )}
    </span>
  </div>

  {entry.status === 'no_pick' ? (
    <>
      <h1 data-i18n="noPickTitle">{label('noPickTitle', lang)}</h1>
      <p class="muted" data-i18n="noPickBody">{label('noPickBody', lang)}</p>
      {entry.scores && (
        <p class="muted">
          <span data-i18n-show="ko" hidden={lang !== 'ko'}>임계 점수</span>
          <span data-i18n-show="en" hidden={lang !== 'en'}>Threshold</span>: {entry.scores.threshold}
          {entry.meta && (
            <>
              {' · '}
              <span data-i18n-show="ko" hidden={lang !== 'ko'}>스크리닝</span>
              <span data-i18n-show="en" hidden={lang !== 'en'}>Screened</span>: {entry.meta.candidatesScreened}
            </>
          )}
        </p>
      )}
    </>
  ) : entry.stock && entry.reasoning && entry.scores ? (
    <>
      <h1>{entry.stock.symbol}</h1>
      <p class="muted">
        <DualText text={entry.stock.name} lang={lang} /> · {entry.stock.exchange}
      </p>
      {profile && (overview('ko') || overview('en')) && (
        <section class="profile-section">
          <h2 class="section-title" data-i18n="companyProfile">{label('companyProfile', lang)}</h2>
          <p data-i18n-show="ko" hidden={lang !== 'ko'}>{overview('ko')}</p>
          <p data-i18n-show="en" hidden={lang !== 'en'}>{overview('en')}</p>
          {detail && (profile.sector || profile.industry) && (
            <p class="muted profile-meta">
              {profile.sector && (
                <span>
                  <span data-i18n="sector">{label('sector', lang)}</span>:
                  {' '}
                  <DualText text={profile.sector} lang={lang} />
                </span>
              )}
              {profile.sector && profile.industry && <span> · </span>}
              {profile.industry && (
                <span>
                  <span data-i18n="industry">{label('industry', lang)}</span>:
                  {' '}
                  <DualText text={profile.industry} lang={lang} />
                </span>
              )}
            </p>
          )}
        </section>
      )}
      <DualText text={entry.reasoning.summary} lang={lang} as="p" />

      <div class="score-grid">
        <div class="score-item">
          <div class="value">{entry.scores.composite.toFixed(1)}</div>
          <div class="label" data-i18n="composite">{label('composite', lang)}</div>
        </div>
        {entry.scores.size != null && (
          <div class="score-item">
            <div class="value">{entry.scores.size.toFixed(1)}</div>
            <div class="label" data-i18n="size">{label('size', lang)}</div>
          </div>
        )}
        <div class="score-item">
          <div class="value">{entry.scores.growth.toFixed(1)}</div>
          <div class="label" data-i18n="growth">{label('growth', lang)}</div>
        </div>
        <div class="score-item">
          <div class="value">{entry.scores.valuation.toFixed(1)}</div>
          <div class="label" data-i18n="valuation">{label('valuation', lang)}</div>
        </div>
        {entry.scores.entry != null && (
          <div class="score-item">
            <div class="value">{entry.scores.entry.toFixed(1)}</div>
            <div class="label" data-i18n="entry">{label('entry', lang)}</div>
          </div>
        )}
        <div class="score-item">
          <div class="value">{entry.scores.momentum.toFixed(1)}</div>
          <div class="label" data-i18n="momentum">{label('momentum', lang)}</div>
        </div>
        <div class="score-item">
          <div class="value">{entry.scores.quality.toFixed(1)}</div>
          <div class="label" data-i18n="quality">{label('quality', lang)}</div>
        </div>
      </div>

      {detail ? (
        <>
          {entry.reasoning.size && (
            <>
              <h2 class="section-title" data-i18n="size">{label('size', lang)}</h2>
              <DualText text={entry.reasoning.size} lang={lang} as="p" />
            </>
          )}
          <h2 class="section-title" data-i18n="growth">{label('growth', lang)}</h2>
          <DualText text={entry.reasoning.growth} lang={lang} as="p" />
          <h2 class="section-title" data-i18n="valuation">{label('valuation', lang)}</h2>
          <DualText text={entry.reasoning.valuation} lang={lang} as="p" />
          {entry.reasoning.entry && (
            <>
              <h2 class="section-title" data-i18n="entry">{label('entry', lang)}</h2>
              <DualText text={entry.reasoning.entry} lang={lang} as="p" />
            </>
          )}
          <h2 class="section-title" data-i18n="momentum">{label('momentum', lang)}</h2>
          <DualText text={entry.reasoning.momentum} lang={lang} as="p" />
          {entry.reasoning.quality && (
            <>
              <h2 class="section-title" data-i18n="quality">{label('quality', lang)}</h2>
              <DualText text={entry.reasoning.quality} lang={lang} as="p" />
            </>
          )}
          <h2 class="section-title" data-i18n="risks">{label('risks', lang)}</h2>
          <ul class="risk-list">
            {entry.reasoning.risks.map((risk) => (
              <DualText text={risk} lang={lang} as="li" />
            ))}
          </ul>
        </>
      ) : (
        <p>
          <a href={`${base}daily/${entry.date}?lang=${lang}`}>
            <span data-i18n="viewDetail">{label('viewDetail', lang)}</span> →
          </a>
        </p>
      )}
    </>
  ) : null}

  {topCandidates && topCandidates.length > 0 && (
    <details class="top-n">
      <summary data-i18n="topCandidates">{label('topCandidates', lang)}</summary>
      <p class="muted top-n-help" data-i18n="topCandidatesHelp">{label('topCandidatesHelp', lang)}</p>
      <ol class="top-n-list">
        {topCandidates.map((c) => (
          <li>
            <div class="top-n-head">
              <strong>#{c.rank}</strong>
              <span>{c.symbol}</span>
              <span class="muted">
                <DualText text={c.name} lang={lang} /> · {c.exchange}
              </span>
            </div>
            <div class="score-grid top-n-scores">
              {axisRows(c).map((row) => (
                <div class="score-item">
                  <div class="value">{row.value.toFixed(1)}</div>
                  <div class="label" data-i18n={row.key}>{label(row.key, lang)}</div>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </details>
  )}
</article>

<style>
  .top-n {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .top-n summary {
    cursor: pointer;
    font-weight: 600;
  }
  .top-n-help {
    margin: 0.5rem 0 0.75rem;
    font-size: 0.9rem;
  }
  .top-n-list {
    margin: 0;
    padding-left: 1.2rem;
  }
  .top-n-list > li {
    margin-bottom: 1rem;
  }
  .top-n-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .top-n-scores {
    margin: 0.35rem 0 0;
  }
</style>
