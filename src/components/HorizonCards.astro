---
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { HorizonSummary } from '../lib/performanceAggregate';

interface Props {
  lang: Lang;
  horizons: HorizonSummary[];
}

const { lang, horizons } = Astro.props;
const presentation = horizons.filter((h) => h.tier === 'presentation');
const secondary = horizons.filter((h) => h.tier === 'secondary');

const horizonLabelKey = {
  '1M': 'horizon1M',
  '3M': 'horizon3M',
  '6M': 'horizon6M',
  '1Y': 'horizon1Y',
  H20: 'horizonH20',
  H60: 'horizonH60',
} as const;

function horizonKey(id: string): (typeof horizonLabelKey)[keyof typeof horizonLabelKey] {
  return horizonLabelKey[(id in horizonLabelKey ? id : '1M') as keyof typeof horizonLabelKey];
}

function pct(n: number | null | undefined): string {
  if (n == null || Number.isNaN(n)) return '—';
  return `${(n * 100).toFixed(2)}%`;
}

function signClass(n: number | null | undefined): string {
  if (n == null || Number.isNaN(n)) return 'pending';
  return n >= 0 ? 'pos' : 'neg';
}

const anyEmpty = horizons.some((h) => !h.available);
---

<section>
  <h2 class="section-title" data-i18n="performanceHorizons">{label('performanceHorizons', lang)}</h2>

  <div class="horizon-grid">
    {presentation.map((h) => (
      <div class:list={['horizon-card', { empty: !h.available }]}>
        <div class="head">
          <span class="name" data-i18n={horizonKey(h.horizonId)}>
            {label(horizonKey(h.horizonId), lang)}
          </span>
          <span class="num n">n={h.nComplete}</span>
        </div>
        {h.available ? (
          <>
            <p class={`num value ${signClass(h.avgPickReturn)}`}>{pct(h.avgPickReturn)}</p>
            <p class="num bench">
              <span data-i18n="performanceAvgBench">{label('performanceAvgBench', lang)}</span>{' '}
              {h.excessClaimAllowed ? (
                <span class={signClass(h.avgBenchReturn)}>{pct(h.avgBenchReturn)}</span>
              ) : (
                <span class="pending">—</span>
              )}
            </p>
          </>
        ) : (
          <>
            <p class="num value">—</p>
            <p class="bench" data-i18n="performanceHorizonUnavailable">
              {label('performanceHorizonUnavailable', lang)}
            </p>
          </>
        )}
      </div>
    ))}
  </div>

  {anyEmpty && (
    <p class="muted" style="margin: 0.6rem 0 0; font-size: 0.78rem;" data-i18n="performanceSamplesPending">
      {label('performanceSamplesPending', lang)}
    </p>
  )}

  <h3 class="section-title" data-i18n="performanceSecondaryHorizons">
    {label('performanceSecondaryHorizons', lang)}
  </h3>
  <div class="horizon-secondary">
    {secondary.map((h) => (
      <div class:list={['horizon-strip', { empty: !h.available }]}>
        <span class="num">
          <span data-i18n={horizonKey(h.horizonId)}>{label(horizonKey(h.horizonId), lang)}</span>
          <span class="muted"> n={h.nComplete}</span>
        </span>
        {h.available ? (
          <span class="num">
            <strong class={signClass(h.avgPickReturn)}>{pct(h.avgPickReturn)}</strong>
            <span class="muted" style="font-size: 0.78rem;">
              {' / '}
              <span data-i18n="performanceAvgBench">{label('performanceAvgBench', lang)}</span>{' '}
              {h.excessClaimAllowed ? pct(h.avgBenchReturn) : '—'}
            </span>
          </span>
        ) : (
          <span class="num pending">—</span>
        )}
      </div>
    ))}
  </div>

  {horizons.some((h) => h.survivorshipCaveat) && (
    <p class="muted" style="margin: 0.75rem 0 0; font-size: 0.78rem;" data-i18n="performanceSurvivorshipCaveat">
      {label('performanceSurvivorshipCaveat', lang)}
    </p>
  )}
</section>
