---
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<article class="card">
  <h1 data-i18n="performanceEmptyTitle">{label('performanceEmptyTitle', lang)}</h1>
  <p class="muted" data-i18n="performanceEmptyBody">{label('performanceEmptyBody', lang)}</p>
</article>
