---
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { DailyEntry, LocalizedText } from '../lib/types';
import { getTodayDateString } from '../lib/daily';
import DualText from './DualText.astro';

interface Props {
  year: number;
  month: number;
  entries: Map<string, DailyEntry>;
  lang: Lang;
}

type CalendarCell =
  | { kind: 'blank' }
  | { kind: 'empty-day'; day: number }
  | {
      kind: 'pick';
      day: number;
      date: string;
      symbol: string;
      name: LocalizedText;
      market: 'KR' | 'US';
      composite: number | null;
    }
  | { kind: 'no-pick'; day: number };

const { year, month, entries, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const today = getTodayDateString();

const firstDay = new Date(year, month - 1, 1);
const startWeekday = firstDay.getDay();
const daysInMonth = new Date(year, month, 0).getDate();

const prev = month === 1 ? { y: year - 1, m: 12 } : { y: year, m: month - 1 };
const next = month === 12 ? { y: year + 1, m: 1 } : { y: year, m: month + 1 };

const weekdaysKo = ['일', '월', '화', '수', '목', '금', '토'];
const weekdaysEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

/** Score colour scale: same hue as --accent, chroma drops with the score. */
function tone(value: number): string {
  if (value >= 80) return 'var(--s-high)';
  if (value >= 60) return 'var(--s-mid)';
  return 'var(--s-low)';
}

const rows: CalendarCell[][] = [];
let cells: CalendarCell[] = [];

for (let i = 0; i < startWeekday; i++) {
  cells.push({ kind: 'blank' });
}

for (let day = 1; day <= daysInMonth; day++) {
  const date = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
  const entry = entries.get(date);
  if (entry?.status === 'pick' && entry.stock) {
    cells.push({
      kind: 'pick',
      day,
      date,
      symbol: entry.stock.symbol,
      name: entry.stock.name,
      market: entry.market,
      composite: entry.scores?.composite ?? null,
    });
  } else if (entry?.status === 'no_pick') {
    cells.push({ kind: 'no-pick', day });
  } else {
    cells.push({ kind: 'empty-day', day });
  }

  if (cells.length === 7) {
    rows.push(cells);
    cells = [];
  }
}

if (cells.length > 0) {
  while (cells.length < 7) {
    cells.push({ kind: 'blank' });
  }
  rows.push(cells);
}
---

<div class="calendar-nav">
  <a
    class="icon-btn"
    href={`${base}archive?year=${prev.y}&month=${prev.m}&lang=${lang}`}
    aria-label={label('prevMonth', lang)}
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
  </a>
  <strong>{year}-{String(month).padStart(2, '0')}</strong>
  <a
    class="icon-btn"
    href={`${base}archive?year=${next.y}&month=${next.m}&lang=${lang}`}
    aria-label={label('nextMonth', lang)}
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 18l6-6-6-6"></path>
    </svg>
  </a>
</div>

<div class="calendar-legend">
  <span>
    <span class="dot" style="background: var(--kr);"></span>
    <span data-i18n="marketKR">{label('marketKR', lang)}</span>
  </span>
  <span>
    <span class="dot" style="background: var(--us);"></span>
    <span data-i18n="marketUS">{label('marketUS', lang)}</span>
  </span>
  <span>
    <span class="track" style="width: 22px; height: 3px;"
      ><span style="width: 76%; background: var(--s-mid);"></span></span
    >
    <span data-i18n="calendarScoreLegend">{label('calendarScoreLegend', lang)}</span>
  </span>
  <span>
    <span class="swatch"></span>
    <span data-i18n="calendarUnpublished">{label('calendarUnpublished', lang)}</span>
  </span>
</div>

<div class="calendar-scroll">
  <table class="calendar" aria-label={label('archive', lang)}>
    <thead>
      <tr data-i18n-show="ko" hidden={lang !== 'ko'}>
        {weekdaysKo.map((d, i) => (
          <th class:list={{ weekend: i === 0 || i === 6 }}>{d}</th>
        ))}
      </tr>
      <tr data-i18n-show="en" hidden={lang !== 'en'}>
        {weekdaysEn.map((d, i) => (
          <th class:list={{ weekend: i === 0 || i === 6 }}>{d}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) =>
              cell.kind === 'blank' ? (
                <td class="blank" />
              ) : cell.kind === 'pick' ? (
                <td class:list={['has-pick', { today: cell.date === today }]}>
                  <a class="cal-link" href={`${base}daily/${cell.date}?lang=${lang}`}>
                    <span class="cal-day">
                      <span class:list={['num', { weekend: i === 0 || i === 6 }]}>{cell.day}</span>
                      {cell.date === today ? (
                        <span class="cal-today" data-i18n="today">
                          {label('today', lang)}
                        </span>
                      ) : null}
                      <span
                        class="dot"
                        style={`background: var(--${cell.market === 'KR' ? 'kr' : 'us'});`}
                      />
                    </span>
                    <span class="num cal-symbol">{cell.symbol}</span>
                    <span class="cal-name">
                      <DualText text={cell.name} lang={lang} />
                    </span>
                    {cell.composite != null && (
                      <span class="cal-score">
                        <span class="track">
                          <span
                            style={`width: ${Math.min(Math.max(cell.composite, 0), 100)}%; background: ${tone(cell.composite)};`}
                          />
                        </span>
                        <span class="num value">{cell.composite.toFixed(1)}</span>
                      </span>
                    )}
                  </a>
                </td>
              ) : cell.kind === 'no-pick' ? (
                <td>
                  <div class="cal-day">
                    <span class:list={['num', { weekend: i === 0 || i === 6 }]}>{cell.day}</span>
                  </div>
                  <div class="cal-none" data-i18n="none">
                    {label('none', lang)}
                  </div>
                </td>
              ) : (
                <td>
                  <div class="cal-day">
                    <span class:list={['num', { weekend: i === 0 || i === 6 }]}>{cell.day}</span>
                  </div>
                </td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="muted" style="margin: 1rem 0 0; font-size: 0.78rem;" data-i18n="calendarRotationNote">
  {label('calendarRotationNote', lang)}
</p>
