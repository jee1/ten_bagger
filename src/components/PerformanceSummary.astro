---
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { MarketPerformanceView } from '../lib/performanceAggregate';

interface Props {
  lang: Lang;
  view: MarketPerformanceView;
}

const { lang, view } = Astro.props;
const series = view.cumulative;

function pct(n: number | null | undefined): string {
  if (n == null || Number.isNaN(n)) return '—';
  return `${(n * 100).toFixed(2)}%`;
}

const points = series?.points ?? [];
const w = 320;
const h = 80;
const pad = 4;
let svgPortfolio = '';
let svgBench = '';
if (points.length >= 2) {
  const ys = points.map((p) => p.portfolioCumulative);
  const bys = points.map((p) => p.benchmarkCumulative).filter((v): v is number => v != null);
  const all = [...ys, ...bys];
  const minY = Math.min(...all, 0);
  const maxY = Math.max(...all, 0);
  const span = maxY - minY || 1;
  const xAt = (i: number) => pad + (i / (points.length - 1)) * (w - 2 * pad);
  const yAt = (v: number) => h - pad - ((v - minY) / span) * (h - 2 * pad);
  svgPortfolio = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${xAt(i)},${yAt(p.portfolioCumulative)}`).join(' ');
  const benchPts = points
    .map((p, i) => (p.benchmarkCumulative == null ? null : [i, p.benchmarkCumulative] as const))
    .filter((x): x is readonly [number, number] => x != null);
  if (benchPts.length >= 2) {
    svgBench = benchPts
      .map(([i, v], j) => `${j === 0 ? 'M' : 'L'}${xAt(i)},${yAt(v)}`)
      .join(' ');
  }
}
---

<article class="card">
  <h2 data-i18n="performanceCumulative">{label('performanceCumulative', lang)}</h2>
  {view.asOfDate && (
    <p class="muted">
      <span data-i18n="performanceAsOf">{label('performanceAsOf', lang)}</span>: {view.asOfDate}
    </p>
  )}
  {view.priceAdjustment && (
    <p class="muted">
      <span data-i18n="performancePriceAdjustment">{label('performancePriceAdjustment', lang)}</span>:
      {' '}
      <code>{view.priceAdjustment}</code>
    </p>
  )}
  {view.priceBasisValidation === 'incomplete' && (
    <p class="warn" role="status">
      <span data-i18n="performancePriceBasisIncomplete"
        >{label('performancePriceBasisIncomplete', lang)}</span
      >
    </p>
  )}
  <p data-i18n="performanceHypothetical">{label('performanceHypothetical', lang)}</p>
  <p class="muted" data-i18n="performanceEqualWeight">{label('performanceEqualWeight', lang)}</p>
  <p class="muted" data-i18n="performanceIndexNote">{label('performanceIndexNote', lang)}</p>
  <p class="muted">
    <span data-i18n-show="ko" hidden={lang !== 'ko' || view.market !== 'KR'}
      >{label('performanceBenchmarkIdKR', 'ko')}</span
    >
    <span data-i18n-show="en" hidden={lang !== 'en' || view.market !== 'KR'}
      >{label('performanceBenchmarkIdKR', 'en')}</span
    >
    <span data-i18n-show="ko" hidden={lang !== 'ko' || view.market !== 'US'}
      >{label('performanceBenchmarkIdUS', 'ko')}</span
    >
    <span data-i18n-show="en" hidden={lang !== 'en' || view.market !== 'US'}
      >{label('performanceBenchmarkIdUS', 'en')}</span
    >
  </p>

  {series ? (
    <>
      <p>
        <strong data-i18n="performancePortfolio">{label('performancePortfolio', lang)}</strong>: {pct(series.finalPortfolioReturn)}
        {' · '}
        <strong data-i18n="performanceBenchmark">{label('performanceBenchmark', lang)}</strong>:{' '}
        {series.excessClaimAllowed
          ? pct(series.finalBenchmarkReturn)
          : <span data-i18n="performanceBenchmarkUnavailable">{label('performanceBenchmarkUnavailable', lang)}</span>}
        <span class="muted"> ({series.horizonId})</span>
      </p>
      {view.hasSurvivorshipCaveat && (
        <p class="muted" data-i18n="performanceSurvivorshipCaveat"
          >{label('performanceSurvivorshipCaveat', lang)}</p
        >
      )}

      {points.length >= 2 && (
        <svg
          class="perf-spark"
          viewBox={`0 0 ${w} ${h}`}
          width="100%"
          height={h}
          role="img"
          aria-hidden="true"
        >
          {svgPortfolio && <path d={svgPortfolio} fill="none" stroke="var(--accent)" stroke-width="2" />}
          {svgBench && <path d={svgBench} fill="none" stroke="var(--muted)" stroke-width="1.5" />}
        </svg>
      )}

      <table class="perf-table">
        <caption class="muted" data-i18n="performanceCumulative">{label('performanceCumulative', lang)}</caption>
        <thead>
          <tr>
            <th data-i18n="performanceTableDate">{label('performanceTableDate', lang)}</th>
            <th data-i18n="performanceTableSymbol">{label('performanceTableSymbol', lang)}</th>
            <th data-i18n="performanceTablePortfolio">{label('performanceTablePortfolio', lang)}</th>
            <th data-i18n="performanceTableBench">{label('performanceTableBench', lang)}</th>
          </tr>
        </thead>
        <tbody>
          {points.map((p) => (
            <tr>
              <td>{p.pickDate}</td>
              <td>{p.symbol}</td>
              <td>{pct(p.portfolioCumulative)}</td>
              <td>{pct(p.benchmarkCumulative)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ) : (
    <p class="muted" data-i18n="performanceHorizonUnavailable"
      >{label('performanceHorizonUnavailable', lang)}</p
    >
  )}
</article>

<style>
  .perf-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .perf-table th,
  .perf-table td {
    border-bottom: 1px solid var(--border);
    padding: 0.4rem 0.5rem;
    text-align: left;
  }
  .perf-spark {
    margin-top: 0.75rem;
    display: block;
  }
  .warn {
    color: var(--accent, #b45309);
    background: color-mix(in srgb, var(--accent, #b45309) 12%, transparent);
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
  }
</style>
