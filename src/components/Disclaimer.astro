---
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  variant?: 'default' | 'digest';
}

const { lang, variant = 'default' } = Astro.props;
const bodyKey = variant === 'digest' ? 'digestDisclaimer' : 'disclaimer';
---

<aside class="disclaimer" role="note">
  <strong>
    <span data-i18n-show="ko" hidden={lang !== 'ko'}>투자 유의</span>
    <span data-i18n-show="en" hidden={lang !== 'en'}>Disclaimer</span>:
  </strong>
  <span data-i18n={bodyKey}>{label(bodyKey, lang)}</span>
</aside>
