---
import Layout from '../layouts/Layout.astro';
import PerformanceEmpty from '../components/PerformanceEmpty.astro';
import PerformanceSummary from '../components/PerformanceSummary.astro';
import HorizonCards from '../components/HorizonCards.astro';
import PerformanceTable from '../components/PerformanceTable.astro';
import { label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { loadPerformanceBundle, type Market } from '../lib/performanceLoad';
import { aggregateMarket } from '../lib/performanceAggregate';

const lang = (Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'ko') as Lang;
const marketParam = Astro.url.searchParams.get('market');
const initialMarket: Market = marketParam === 'US' ? 'US' : 'KR';
const base = import.meta.env.BASE_URL;

const markets: Market[] = ['KR', 'US'];
const views = markets.map((market) => {
  const bundle = loadPerformanceBundle(market);
  return { market, view: aggregateMarket(bundle, market) };
});

const krHref = `${base}performance?lang=${lang}&market=KR`;
const usHref = `${base}performance?lang=${lang}&market=US`;
---

<Layout title={label('performance', lang)} titleKey="performance" lang={lang}>
  <div class="page-head">
    <div>
      <h1 data-i18n="performance">{label('performance', lang)}</h1>
      <p class="muted" data-i18n="performanceHypothetical">
        {label('performanceHypothetical', lang)}
      </p>
    </div>
    <nav class="segmented" aria-label={label('performanceMarket', lang)}>
      <a href={krHref} data-market-link="KR" class:list={{ active: initialMarket === 'KR' }}
        ><span data-i18n="marketKR">{label('marketKR', lang)}</span></a
      >
      <a href={usHref} data-market-link="US" class:list={{ active: initialMarket === 'US' }}
        ><span data-i18n="marketUS">{label('marketUS', lang)}</span></a
      >
    </nav>
  </div>

  {
    views.map(({ market, view }) => (
      <section data-market-panel={market} hidden={market !== initialMarket}>
        {view.pageEmpty ? (
          <PerformanceEmpty lang={lang} />
        ) : (
          <>
            <PerformanceSummary lang={lang} view={view} />
            <HorizonCards lang={lang} horizons={view.horizons} />
            <PerformanceTable lang={lang} view={view} />
            {view.empty && (
              <p class="muted">
                <span data-i18n="performanceHorizonUnavailable">
                  {label('performanceHorizonUnavailable', lang)}
                </span>
              </p>
            )}
          </>
        )}
      </section>
    ))
  }
</Layout>
