---
import Layout from '../../layouts/Layout.astro';
import { getAllDates, getDailyEntry } from '../../lib/daily';
import {
  buildDigestDayRow,
  countMarketDays,
  countWeekPicks,
  deriveDigestWeekPerformance,
  formatWeekRangeLabel,
  groupDatesByIsoWeek,
  listIsoWeekKeys,
  parseIsoWeekKey,
} from '../../lib/digest';
import { label, localeToLang } from '../../lib/i18n';
import { loadPerformanceBundle } from '../../lib/performanceLoad';
import { localeHref } from '../../lib/staticNav';

export function getStaticPaths() {
  return listIsoWeekKeys(getAllDates()).map((week) => ({ params: { week } }));
}

const { week } = Astro.params;
const lang = localeToLang(Astro.currentLocale);
const base = import.meta.env.BASE_URL;

let parts: ReturnType<typeof parseIsoWeekKey>;
try {
  parts = parseIsoWeekKey(week!);
} catch {
  return Astro.redirect(localeHref(base, lang, 'digest'));
}

const weekDates = groupDatesByIsoWeek(getAllDates()).get(week!) ?? [];
if (weekDates.length === 0) {
  return Astro.redirect(localeHref(base, lang, 'digest'));
}

const loaded = await Promise.all(weekDates.map(async (date) => getDailyEntry(date)));
const entries = loaded.filter((entry) => entry != null).map((entry) => buildDigestDayRow(entry));
const marketCounts = countMarketDays(entries);
const pickCount = countWeekPicks(entries);
const perfView = deriveDigestWeekPerformance(
  entries,
  loadPerformanceBundle('KR'),
  loadPerformanceBundle('US'),
);
const rangeLabel = formatWeekRangeLabel(parts.isoYear, parts.isoWeek, lang);
const pageTitle = `${week} | ${label('digestTitle', lang)}`;

const sampleNote = label('digestPerformanceSampleNote', lang)
  .replace('{kr}', String(perfView.completedKr))
  .replace('{us}', String(perfView.completedUs))
  .replace('{total}', String(perfView.completedSamples));
---

<Layout
  title={pageTitle}
  titleKey="digestTitle"
  descriptionKey="digestDescription"
  lang={lang}
  disclaimerVariant="digest"
>
  <article class="doc-body digest-page">
    <p class="muted">
      <a href={localeHref(base, lang, 'digest')} data-i18n="digestBackToIndex">
        {label('digestBackToIndex', lang)}
      </a>
    </p>
    <h1 class="num">{week}</h1>
    <p class="muted digest-week-range">{rangeLabel}</p>
    <p class="muted">
      <span data-i18n="digestDayCount">{label('digestDayCount', lang)}</span>: {entries.length}
      {' · '}
      <span data-i18n="digestPickCount">{label('digestPickCount', lang)}</span>: {pickCount}
    </p>
    <p class="muted">
      <span data-i18n="digestMarketCounts">{label('digestMarketCounts', lang)}</span>:
      <span data-i18n="marketKR">{label('marketKR', lang)}</span> {marketCounts.kr}
      {' · '}
      <span data-i18n="marketUS">{label('marketUS', lang)}</span> {marketCounts.us}
    </p>
    <p class="muted digest-week-note" data-i18n="calendarRotationNote">
      {label('calendarRotationNote', lang)}
    </p>
    <p class="muted digest-week-note" data-i18n="digestWeekNote">{label('digestWeekNote', lang)}</p>

    <table class="perf-table digest-table">
      <thead>
        <tr>
          <th data-i18n="performanceTableDate">{label('performanceTableDate', lang)}</th>
          <th data-i18n="performanceMarket">{label('performanceMarket', lang)}</th>
          <th data-i18n="digestTableTicker">{label('digestTableTicker', lang)}</th>
          <th class="right" data-i18n="composite">{label('composite', lang)}</th>
          <th data-i18n="digestTableLink">{label('digestTableLink', lang)}</th>
        </tr>
      </thead>
      <tbody>
        {
          entries.map((row) => (
            <tr>
              <td class="num">{row.date}</td>
              <td>
                <span class={`badge ${row.market === 'KR' ? 'kr' : 'us'}`}>
                  {row.market}
                </span>
              </td>
              <td class="num">
                {row.symbol ?? '—'}
              </td>
              <td class="num right">{row.composite != null ? row.composite.toFixed(1) : '—'}</td>
              <td>
                <a href={localeHref(base, lang, `daily/${row.date}`)} data-i18n="viewDetail">
                  {label('viewDetail', lang)}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <section class="digest-performance" aria-labelledby="digest-performance-heading">
      <h2 id="digest-performance-heading" data-i18n="digestPerformanceHeading">
        {label('digestPerformanceHeading', lang)}
      </h2>
      <p class="muted" data-i18n="digestPerformanceNotComputed">
        {label('digestPerformanceNotComputed', lang)}
      </p>
      {
        perfView.insufficientSample && (
          <p class="muted" data-i18n="digestPerformanceInsufficient">
            {label('digestPerformanceInsufficient', lang)}
          </p>
        )
      }
      {
        perfView.completedSamples > 0 && (
          <p class="muted num">{sampleNote}</p>
        )
      }
      <p class="muted" data-i18n="digestPerformanceModeledNote">
        {label('digestPerformanceModeledNote', lang)}
      </p>
      <ul class="about-links">
        <li>
          <a href={localeHref(base, lang, 'performance')} data-i18n="performance">
            {label('performance', lang)}
          </a>
        </li>
        <li>
          <a href={localeHref(base, lang, 'methodology')} data-i18n="methodology">
            {label('methodology', lang)}
          </a>
        </li>
        <li>
          <a href={localeHref(base, lang, 'methodology/price-basis')} data-i18n="performancePriceBasisNoteLink">
            {label('performancePriceBasisNoteLink', lang)}
          </a>
        </li>
      </ul>
    </section>

    <section class="digest-cta" aria-labelledby="digest-cta-heading">
      <h2 id="digest-cta-heading" data-i18n="digestCtaHeading">{label('digestCtaHeading', lang)}</h2>
      <ul class="about-links">
        <li>
          <a href={localeHref(base, lang, 'archive')} data-i18n="archive">{label('archive', lang)}</a>
        </li>
        <li>
          <a href={localeHref(base, lang, 'follow')} data-i18n="followTitle">{label('followTitle', lang)}</a>
        </li>
      </ul>
    </section>
  </article>
</Layout>
