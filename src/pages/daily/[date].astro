---
import Layout from '../../layouts/Layout.astro';
import DailyCard from '../../components/DailyCard.astro';
import { getAllDates, getDailyEntry } from '../../lib/daily';
import { label, localeToLang } from '../../lib/i18n';
import { localeHref } from '../../lib/staticNav';

export function getStaticPaths() {
  return getAllDates().map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
const lang = localeToLang(Astro.currentLocale);
const base = import.meta.env.BASE_URL;
const entry = await getDailyEntry(date!);

if (!entry) {
  return Astro.redirect(localeHref(base, lang, 'archive'));
}
---

<Layout title={date!} lang={lang}>
  <p><a href={localeHref(base, lang, 'archive')}>← {label('archive', lang)}</a></p>
  <DailyCard entry={entry} lang={lang} detail />
</Layout>
