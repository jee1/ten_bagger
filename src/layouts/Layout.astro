---
import '../styles/global.css';
import { labels, label } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import Disclaimer from '../components/Disclaimer.astro';
import { getKstDate } from '../lib/daily';
import { splitLocalePath, localeHref } from '../lib/staticNav';

interface Props {
  title: string;
  titleKey?: keyof typeof labels;
  lang?: Lang;
}

const { title, titleKey, lang = 'ko' } = Astro.props;
const base = import.meta.env.BASE_URL;
const kst = getKstDate();
const defaultYear = kst.getFullYear();
const defaultMonth = kst.getMonth() + 1;

const { rel, prefixed } = splitLocalePath(Astro.url.pathname, base);
const koUrl = localeHref(base, 'ko', rel);
const enUrl = localeHref(base, 'en', rel);

const pageTitle = `${title} | ${label('siteName', lang)}`;
const description = label('tagline', lang);
const canonicalURL = new URL(localeHref(base, lang, rel), Astro.site);
const ogImage = new URL(`${base}og-default.png`, Astro.site);
const goatCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE ?? 'tenbagger';

const labelsJson = JSON.stringify(labels);

const section = rel === '' ? 'today' : rel.split('/')[0];
const isActive = (key: string) =>
  key === 'today' ? section === 'today' || section === 'daily' : section === key;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="jN6qQ_VKT9OjatY4TL1Iq4tJCw6cxzV9_bjejTZqHB8"
    />
    <meta name="description" content={description} data-i18n-attr="content:tagline" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ko" href={new URL(localeHref(base, 'ko', rel), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localeHref(base, 'en', rel), Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeHref(base, 'ko', rel), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={label('siteName', lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={label('siteName', lang)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ten Bagger Daily RSS"
      href={`${base}rss.xml`}
    />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <title data-page-title-key={titleKey ?? ''}>
      {pageTitle}
    </title>
    <script type="application/json" id="i18n-labels" set:html={labelsJson} />
    <script
      type="application/json"
      id="static-nav-defaults"
      set:html={JSON.stringify({ year: defaultYear, month: defaultMonth, lang, localePrefixed: prefixed })}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <div class="brand-row">
          <a class="brand" href={localeHref(base, lang, '')}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="color: var(--accent);"
            >
              <path d="M3 17l5.5-6 4 4L21 6"></path>
              <path d="M15 6h6v6"></path>
            </svg>
            <span data-i18n="siteName">{label('siteName', lang)}</span>
          </a>
          <div class="lang-toggle">
            <a href={koUrl} data-lang-link="ko" class:list={{ active: lang === 'ko' }}>KO</a>
            <a href={enUrl} data-lang-link="en" class:list={{ active: lang === 'en' }}>EN</a>
          </div>
        </div>
        <nav class="nav">
          <a
            href={localeHref(base, lang, '')}
            class:list={{ active: isActive('today') }}
            aria-current={isActive('today') ? 'page' : undefined}
            ><span data-i18n="today">{label('today', lang)}</span></a
          >
          <a
            href={localeHref(base, lang, 'archive')}
            class:list={{ active: isActive('archive') }}
            aria-current={isActive('archive') ? 'page' : undefined}
            ><span data-i18n="archive">{label('archive', lang)}</span></a
          >
          <a
            href={localeHref(base, lang, 'methodology')}
            class:list={{ active: isActive('methodology') }}
            aria-current={isActive('methodology') ? 'page' : undefined}
            ><span data-i18n="methodology">{label('methodology', lang)}</span></a
          >
          <a
            href={localeHref(base, lang, 'performance')}
            class:list={{ active: isActive('performance') }}
            aria-current={isActive('performance') ? 'page' : undefined}
            ><span data-i18n="performance">{label('performance', lang)}</span></a
          >
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
      <Disclaimer lang={lang} />
    </main>
    <script>
      import { archiveYmKey, kstDateString, parseStaticNav, pickFreshnessView } from '../lib/staticNav.ts';
      import type { Lang } from '../lib/i18n.ts';

      type LabelMap = Record<string, { ko: string; en: string }>;

      function readJson<T>(id: string): T {
        const el = document.getElementById(id);
        if (!el?.textContent) throw new Error(`missing #${id}`);
        return JSON.parse(el.textContent) as T;
      }

      function applyStaticNav() {
        const labelMap = readJson<LabelMap>('i18n-labels');
        const defaults = readJson<{
          year: number;
          month: number;
          lang: Lang;
          localePrefixed: boolean;
        }>('static-nav-defaults');
        const state = parseStaticNav(window.location.search, defaults);
        const lang = state.lang as Lang;

        document.documentElement.lang = lang;

        const freshnessRow = document.querySelector<HTMLElement>('[data-pick-date]');
        const pickDate = freshnessRow?.dataset.pickDate;
        if (pickDate) {
          const view = pickFreshnessView(pickDate, kstDateString());
          const labelEl = freshnessRow!.querySelector<HTMLElement>('[data-freshness-label]');
          if (labelEl) labelEl.dataset.i18n = view.labelKey;
          const badge = freshnessRow!.querySelector<HTMLElement>('[data-freshness-badge]');
          badge?.classList.toggle('pick', !view.stale);
          badge?.classList.toggle('none', view.stale);
          document.querySelectorAll<HTMLElement>('[data-freshness-stale]').forEach((el) => {
            el.hidden = !view.stale;
          });
        }

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n;
          if (!key || !labelMap[key]) return;
          el.textContent = labelMap[key][lang];
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-show]').forEach((el) => {
          el.hidden = el.dataset.i18nShow !== lang;
        });

        const titleEl = document.querySelector('title');
        const titleKey = titleEl?.getAttribute('data-page-title-key');
        if (titleEl && titleKey && labelMap[titleKey] && labelMap.siteName) {
          titleEl.textContent = `${labelMap[titleKey][lang]} | ${labelMap.siteName[lang]}`;
        }

        const desc = document.querySelector('meta[name="description"]');
        if (desc && labelMap.tagline) {
          desc.setAttribute('content', labelMap.tagline[lang]);
        }

        document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
          a.classList.toggle('active', a.dataset.langLink === lang);
        });

        document.querySelectorAll<HTMLElement>('[data-market-panel]').forEach((el) => {
          el.hidden = el.dataset.marketPanel !== state.market;
        });
        document.querySelectorAll<HTMLAnchorElement>('[data-market-link]').forEach((a) => {
          a.classList.toggle('active', a.dataset.marketLink === state.market);
        });

        const ym = archiveYmKey(state.year, state.month);
        const panels = document.querySelectorAll<HTMLElement>('[data-archive-ym]');
        if (panels.length) {
          let matched = false;
          panels.forEach((el) => {
            const on = el.dataset.archiveYm === ym;
            el.hidden = !on;
            if (on) matched = true;
          });
          if (!matched) {
            // fall back to last panel (usually current default month baked first)
            panels.forEach((el, i) => {
              el.hidden = i !== panels.length - 1;
            });
          }
        }
      }

      applyStaticNav();
      window.addEventListener('popstate', applyStaticNav);
    </script>
    {
      goatCode ? (
        <script
          is:inline
          data-goatcounter={`https://${goatCode}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      ) : null
    }
  </body>
</html>
