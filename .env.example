# Copy to .env for local production-like builds. CI/Cloudflare: set the same keys as secrets or env vars.
# Cloudflare Web Analytics → Sites → Manage site → Web Analytics → copy token.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Google Search Console → HTML tag method (optional if googleVerificationFallback is set in Layout).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor → meta tag method (optional; tenbagger also supports HTML file under public/).
PUBLIC_NAVER_SITE_VERIFICATION=
