# Copy to ~/.config/ten_bagger/daily.env and chmod 600.
# Do not commit real values. Board fills secrets on the host only.

OPENDART_API_KEY=
PIT_DATA_TOKEN=

# Optional overrides (defaults match README):
# TEN_BAGGER_REPO=/home/jee1lee/git/ten_bagger-daily
# TEN_BAGGER_YF_CACHE_DIR=/home/jee1lee/.cache/ten_bagger/yfinance
# TEN_BAGGER_VENV=/home/jee1lee/.local/share/ten_bagger/venv
# TEN_BAGGER_FORCE=1   # bypass gate skip (backfill only)
# TEN_BAGGER_AS_OF=2026-11-27   # ledger asOfDate (default: target date)
# TEN_BAGGER_FORCE_LEDGER=1    # rerun ledger even when asOfDate is current
# FINNAUT_OHLC_DIR=/path/to/finnaut-ohlc   # optional local OHLC snapshot; default yfinance/stooq
# TEN_BAGGER_ORCA_BIN=/home/jee1lee/.config/orca/linux-orca-cli-shim/orca
# TEN_BAGGER_NOTIFY_FROM=bot:ten-bagger-daily
